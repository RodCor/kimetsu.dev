{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kimetsu-dev",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "kimetsu.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
