{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kimetsu.dev/schemas/well-known-agent-directory-v1.schema.json",
  "title": "kimetsu.dev well-known agent directory pointer",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "gateway",
    "fallback",
    "llms_txt",
    "projects",
    "authentication",
    "read_only",
    "warning"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "gateway": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://agents\\.kimetsu\\.dev/"
    },
    "fallback": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://kimetsu\\.dev/"
    },
    "llms_txt": { "type": "string", "format": "uri" },
    "projects": { "type": "string", "format": "uri" },
    "authentication": { "const": "none" },
    "read_only": { "const": true },
    "warning": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
